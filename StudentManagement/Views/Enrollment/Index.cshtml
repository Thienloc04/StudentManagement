    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Đăng ký Môn học";
}

<div class="container-fluid mt-3">
    <h2 class="text-primary mb-4"><i class="fas fa-book-reader"></i> ĐĂNG KÝ MÔN HỌC CHO HỌC SINH</h2>

    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white font-weight-bold">
            <i class="fas fa-plus-circle"></i> Thực Hiện Đăng Ký Học Phần
        </div>
        <div class="card-body">
            <div class="row">

                <div class="col mb-3">
                    <label class="font-weight-bold">Chọn Học sinh</label>
                    <select id="ddlStudent" class="form-select select2">
                        <option value="">-- Chọn học sinh --</option>
                    </select>
                </div>

                <div class="col-md-5 mb-3">
                    <label class="font-weight-bold">Chọn Môn / Lớp Học Phần:</label>
                    <select id="ddlSubjectClass" class="form-select">
                        <option value="">-- Chọn môn học phần --</option>
                    </select>
                </div>

                <div class="col-md-2 mb-3 align-self-end">
                    <button id="btnEnroll" class="btn btn-success w-100"><i class="fas fa-check"></i> Đăng ký</button>
                </div>

            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-secondary text-white font-weight-bold">
            <i class="fas fa-list"></i> Danh Sách Môn Học Đã Đăng Ký
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Tên Môn Học</th>
                        <th>Số Tín Chỉ</th>
                        <th>Giảng Viên Giảng Dạy</th>
                        <th>Lớp Hành Chính</th>
                        <th>Ngày Đăng Ký</th>
                        <th colspan="2" class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="enrollmentTableBody">
                    <tr>
                        <td colspan="6" class="text-center text-muted">Vui lòng chọn học sinh để xem danh sách môn đã đăng ký</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- MODAL NHẬP / XEM ĐIỂM SỐ -->
<div class="modal fade" id="gradeModal" tabindex="-1" aria-labelledby="gradeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="gradeModalLabel"><i class="fas fa-marker"></i> QUẢN LÝ ĐIỂM SỐ MÔN HỌC</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Thông tin môn học -->
                <div class="alert alert-info py-2">
                    <strong id="modalSubjectTitle">Môn học: ...</strong>
                </div>

                <!-- Bảng danh sách các loại điểm -->
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Loại điểm</th>
                            <th style="width: 120px;">Hệ số</th>
                            <th style="width: 180px;">Điểm số (0 - 10)</th>
                            <th style="width: 120px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="gradeTableBody">
                        <!-- AJAX sẽ đổ dữ liệu vào đây -->
                    </tbody>
                </table>

                <!-- Tổng kết điểm môn -->
                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded border">
                    <span class="fw-bold">ĐTB Môn học (Dự tính):</span>
                    <span id="lblCalculatedGpa" class="fs-4 fw-bold text-success">0.00</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script src="~/js/enrollment.js"></script>
}