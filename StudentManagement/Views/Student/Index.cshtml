@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Danh sách học sinh";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#studentModal">
        + Thêm học sinh
    </button>
    <div>
        <button type="button" id="btnExportPdf" class="btn btn-outline-danger me-2">
            <i class="fas fa-file-pdf"></i> Xuất PDF
        </button>
        <button type="button" id="btnExportExcel" class="btn btn-outline-success">
            <i class="fas fa-file-excel"></i> Xuất Excel
        </button>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header bg-primary text-white font-weight-bold">
        <i class="fas fa-search"></i> Tra cứu & Tìm kiếm Học sinh
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <label>Tên học sinh:</label>
                <input type="text" id="searchName" class="form-control" placeholder="Nhập tên..." />
            </div>
            <div class="col-md-3">
                <label>Lớp học:</label>
                <select id="searchClassId" class="form-control">
                    <option value="">-- Tất cả các lớp --</option>
                    <!-- Dữ liệu lớp học có thể load tự động từ DB -->
                </select>
            </div>
            <div class="col-md-3">
                <label>Học lực:</label>
                <select id="searchRank" class="form-control">
                    <option value="">-- Tất cả học lực --</option>
                    <option value="GIOI">Giỏi (GPA >= 8.0)</option>
                    <option value="KHA">Khá (6.5 <= GPA < 8.0)</option>
                    <option value="TB">Trung bình (5.0 <= GPA < 6.5)</option>
                    <option value="YEU">Yếu (GPA < 5.0)</option>
                </select>
            </div>
            <div class="col-md-3 align-self-end">
                <button id="btnSearch" class="btn btn-success"><i class="fas fa-search"></i> Tìm kiếm</button>
                <button id="btnResetSearch" class="btn btn-secondary"><i class="fas fa-undo"></i> Làm mới</button>
            </div>
        </div>
    </div>
</div>

<h2>Danh sách Học sinh</h2>

<!-- Bảng HTML rỗng, chưa có dữ liệu -->
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Mã HS</th>
            <th>Họ tên</th>
            <th>Giới tính</th>
            <th>Lớp hiện tại</th>
            <th>Điểm TB</th>
            <th>Học lực</th>
            <th>Thao tác</th>

        </tr>
    </thead>
    <tbody id="studentTableBody">
        <!-- Dữ liệu được vẽ bằng jQuery ở đây -->
        <tr>
            <td colspan="5" class="text-center">Đang tải dữ liệu...</td>
        </tr>
    </tbody>
</table>

<!-- Form Modal ẩn -->
<div class="modal fade" id="studentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Học Sinh Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Đặt id cho từng thẻ input để lát jQuery lấy dữ liệu -->
                <div class="mb-3">
                    <label>Mã HS</label>
                    <input type="text" id="txtStudentNo" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Họ và Tên</label>
                    <input type="text" id="txtFullName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Giới tính</label>
                    <select id="ddlSex" class="form-select">
                        <option value="true">Nam</option>
                        <option value="false">Nữ</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label>Ngày sinh</label>
                    <input type="date" id="txtDob" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Email</label>
                    <input type="text" id="txtEmail" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>SĐT</label>
                    <input type="tel" id="telPhone" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Địa chỉ</label>
                    <input type="text" id="txtAddress" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="btnSaveStudent">Lưu lại</button>
            </div>
        </div>
    </div>
</div>

<!-- Form Modal cho Edit -->
<div class="modal fade" id="studentEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa Thông Tin Học Sinh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Đặt id cho từng thẻ input để lát jQuery lấy dữ liệu -->
                <input type="hidden" id="txtEditId" />
                <div class="mb-3">
                    <label>Mã HS</label>
                    <input type="text" id="txtEditStudentNo" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Họ và Tên</label>
                    <input type="text" id="txtEditFullName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Giới tính</label>
                    <select id="ddlEditSex" class="form-select">
                        <option value="true">Nam</option>
                        <option value="false">Nữ</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label>Ngày sinh</label>
                    <input type="date" id="txtEditDob" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Email</label>
                    <input type="text" id="txtEditEmail" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>SĐT</label>
                    <input type="tel" id="telEditPhone" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Địa chỉ</label>
                    <input type="text" id="txtEditAddress" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="btnUpdateStudent">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

<!-- Khai báo vùng viết Script, nó sẽ được đẩy xuống cuối trang Layout -->
@section Scripts {
    <script src="~/js/student.js"></script>
}